{
  "name": "wordflow",
  "private": true,
  "version": "0.2.4",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.mjs",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs --production",
    "test": "tsx --test tests/*.test.ts",
    "build:exam-frequency": "python scripts/build-exam-frequency.py --publish",
    "build:reading": "node scripts/build-reading.mjs",
    "test:exam-frequency": "python tests/exam_frequency_test.py",
    "test:cloud": "python tests/cloud_test.py",
    "test:android-learning": "tsx tests/android-learning.ts",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@ionic/core": "^9.0.4",
    "@ionic/react": "^9.0.4",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "motion": "^13.4.0",
    "papaparse": "^5.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ts-fsrs": "^5.2.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "parse5": "^8.0.1",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.0"
  }
}
